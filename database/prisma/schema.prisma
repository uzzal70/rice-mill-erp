generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum AuthLoginResult {
  SUCCESS
  FAILED
  LOCKED
}

enum ProductionType {
  AUTO
  PARBOILED
  TRADITIONAL
  INTEGRATED
}

enum BusinessMode {
  PADDY_TRADING
  RICE_TRADING
  WHOLESALE
  RETAIL
  DEALER_DISTRIBUTION
  TOLL_MILLING
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  REJECT
  POST
  PRINT
  EXPORT
  VIEW_FINANCIAL
}

enum PartnerType {
  SUPPLIER
  FARMER
  BROKER
  CUSTOMER
}

enum BrokerCommissionType {
  PER_KG
  PER_MON
  PER_TON
  PERCENTAGE
  FIXED_AMOUNT
}

enum ItemKind {
  PADDY
  RICE
  BY_PRODUCT
  PACKAGING
  FUEL
  SPARE_PART
  CONSUMABLE
  OTHER
}

enum StockMovementType {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER
  TRANSFER_IN
  TRANSFER_OUT
  PRODUCTION_IN
  PRODUCTION_OUT
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  REPACK
  DAMAGE
  LOSS
  ADJUSTMENT
  REVERSAL
}

enum LandedCostComponentType {
  TRANSPORT
  LOADING
  UNLOADING
  COMMISSION
  DRYING
  OTHER_DIRECT
}

enum MoistureDeductionFormula {
  DRY_MATTER_CORRECTION
  SLAB_PERCENTAGE
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  CANCELLED
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum UnitOfMeasure {
  KG
  MON
  TON
  BAG
  PIECE
  LITER
}

enum AuthChallengePurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  OTP_LOGIN
}

enum GateDirection {
  INWARD
  OUTWARD
}

enum GatePurpose {
  PROCUREMENT
  SALES
  TRANSFER
  TOLL_MILLING
  OTHER
}

enum GateStatus {
  ENTRY
  WEIGHING
  QUALITY
  RECEIVING
  COMPLETED
  REJECTED
  CANCELLED
}

enum QualitySampleType {
  GATE
  PIT
  FINAL
}

enum QualitySampleStatus {
  SAMPLE
  TESTED
  APPROVED
  REJECTED
}

enum QualityDecision {
  ACCEPT
  REJECT
}

enum ParboilingStageType {
  SOAKING
  STEAMING
  DRYING
}

model Company {
  id                 String              @id @default(cuid())
  name               String
  code               String              @unique
  logoUrl            String?
  registrationNumber String?
  tin                String?
  bin                String?
  address            String?
  district           String?
  division           String?
  phone              String?
  email              String?
  website            String?
  fiscalYearStart    Int                 @default(1)
  currency           String              @default("BDT")
  timezone           String              @default("Asia/Dhaka")
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  factories          Factory[]
  memberships        Membership[]
  roles              Role[]
  settings           CompanySetting?
  partners           Partner[]
  items              Item[]
  godowns            Godown[]
  productionLines    ProductionLine[]
  stockMovements     StockMovement[]
  journals           Journal[]
  auditEvents        AuditEvent[]
  unitConversions    UnitConversion[]
  vehicles           Vehicle[]
  gateEntries        GateEntry[]
  gateAttachments    GateAttachment[]
  weighbridgeTickets WeighbridgeTicket[]
  qualitySamples     QualitySample[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  stockTransfers     StockTransfer[]
  stockAdjustments   StockAdjustment[]
  stockCounts        StockCount[]
  productionBatches  ProductionBatch[]
  dryingBatches      DryingBatch[]
  parboilingBatches  ParboilingBatch[]
  moisturePolicies   MoisturePolicy[]
  purchaseInvoices   PurchaseInvoice[]
  landedCostConfigs  LandedCostComponentConfig[]
  landedCosts        LandedCost[]
  repackingBatches   RepackingBatch[]
  salesQuotations    SalesQuotation[]
  salesQuotationLines SalesQuotationLine[]
  salesOrders        SalesOrder[]
  salesOrderLines    SalesOrderLine[]
  dispatches         Dispatch[]
  dispatchLines      DispatchLine[]

  @@index([active])
}

model Factory {
  id                 String              @id @default(cuid())
  companyId          String
  name               String
  code               String
  address            String?
  managerName        String?
  capacityPerDay     Decimal?            @db.Decimal(14, 3)
  productionType     ProductionType
  businessModes      BusinessMode[]      @default([])
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  godowns            Godown[]
  lines              ProductionLine[]
  memberships        Membership[]
  stockMovements     StockMovement[]
  gateEntries        GateEntry[]
  gateAttachments    GateAttachment[]
  weighbridgeTickets WeighbridgeTicket[]
  qualitySamples     QualitySample[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  stockTransfers     StockTransfer[]
  stockAdjustments   StockAdjustment[]
  stockCounts        StockCount[]
  productionBatches  ProductionBatch[]
  dryingBatches      DryingBatch[]
  parboilingBatches  ParboilingBatch[]
  moisturePolicies   MoisturePolicy[]
  purchaseInvoices   PurchaseInvoice[]
  landedCostConfigs  LandedCostComponentConfig[]
  landedCosts        LandedCost[]
  repackingBatches   RepackingBatch[]
  salesQuotations    SalesQuotation[]
  salesQuotationLines SalesQuotationLine[]
  salesOrders        SalesOrder[]
  salesOrderLines    SalesOrderLine[]
  dispatches         Dispatch[]
  dispatchLines      DispatchLine[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active])
}

model User {
  id                         String              @id @default(cuid())
  email                      String              @unique
  phone                      String?
  passwordHash               String?
  fullName                   String
  status                     UserStatus          @default(INVITED)
  emailVerifiedAt            DateTime?
  failedLoginCount           Int                 @default(0)
  lockedUntil                DateTime?
  lastLoginAt                DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  memberships                Membership[]
  sessions                   AuthSession[]
  authChallenges             AuthChallenge[]
  loginEvents                AuthLoginEvent[]
  auditEvents                AuditEvent[]
  createdGateEntries         GateEntry[]         @relation("GateEntryCreator")
  uploadedGateAttachments    GateAttachment[]    @relation("GateAttachmentUploader")
  operatedWeighbridgeTickets WeighbridgeTicket[] @relation("WeighbridgeOperator")
  sampledQualitySamples      QualitySample[]     @relation("QualitySampler")
  testedQualitySamples       QualitySample[]     @relation("QualityTester")
  approvedQualitySamples     QualitySample[]     @relation("QualityApprover")
  createdPurchaseOrders      PurchaseOrder[]     @relation("PurchaseOrderCreator")
  approvedPurchaseOrders     PurchaseOrder[]     @relation("PurchaseOrderApprover")
  createdGoodsReceipts       GoodsReceipt[]      @relation("GoodsReceiptCreator")
  approvedGoodsReceipts      GoodsReceipt[]      @relation("GoodsReceiptApprover")
  postedGoodsReceipts        GoodsReceipt[]      @relation("GoodsReceiptPoster")
  createdStockTransfers      StockTransfer[]     @relation("StockTransferCreator")
  createdStockAdjustments    StockAdjustment[]   @relation("StockAdjustmentCreator")
  createdStockCounts         StockCount[]        @relation("StockCountCreator")
  postedStockCounts          StockCount[]        @relation("StockCountPoster")
  createdRepackingBatches    RepackingBatch[]   @relation("RepackingBatchCreator")
  approvedRepackingBatches   RepackingBatch[]   @relation("RepackingBatchApprover")
  postedRepackingBatches     RepackingBatch[]   @relation("RepackingBatchPoster")
  createdProductionBatches   ProductionBatch[]   @relation("ProductionBatchCreator")
  approvedProductionBatches  ProductionBatch[]   @relation("ProductionBatchApprover")
  postedProductionBatches    ProductionBatch[]   @relation("ProductionBatchPoster")
  createdDryingBatches       DryingBatch[]       @relation("DryingBatchCreator")
  approvedDryingBatches      DryingBatch[]       @relation("DryingBatchApprover")
  postedDryingBatches        DryingBatch[]       @relation("DryingBatchPoster")
  createdParboilingBatches   ParboilingBatch[]   @relation("ParboilingBatchCreator")
  approvedParboilingBatches  ParboilingBatch[]   @relation("ParboilingBatchApprover")
  postedParboilingBatches    ParboilingBatch[]   @relation("ParboilingBatchPoster")
  createdPurchaseInvoices    PurchaseInvoice[]   @relation("PurchaseInvoiceCreator")
  approvedPurchaseInvoices   PurchaseInvoice[]   @relation("PurchaseInvoiceApprover")
  postedPurchaseInvoices     PurchaseInvoice[]   @relation("PurchaseInvoicePoster")
  landedCostsCalculated     LandedCost[]           @relation("LandedCostCalculatedBy")
  landedCostsApproved      LandedCost[]           @relation("LandedCostApprover")
  landedCostsPosted         LandedCost[]           @relation("LandedCostPoster")
  createdMoisturePolicies    MoisturePolicy[]   @relation("MoisturePolicyCreator")

  @@index([status])
}

model Membership {
  id              String     @id @default(cuid())
  userId          String
  companyId       String
  factoryId       String?
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory         Factory?   @relation(fields: [companyId, factoryId], references: [companyId, id], onDelete: Restrict)
  roleAssignments UserRole[]

  @@unique([userId, companyId, factoryId])
  @@index([companyId, active])
}

model Role {
  id          String           @id @default(cuid())
  companyId   String?
  name        String
  code        String
  description String?
  systemRole  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  assignments UserRole[]

  @@unique([companyId, code])
}

model Permission {
  id          String           @id @default(cuid())
  resource    String
  action      PermissionAction
  description String?
  roles       RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  membershipId String
  roleId       String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  deviceName       String?
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthLoginEvent {
  id         String          @id @default(cuid())
  userId     String?
  result     AuthLoginResult
  deviceName String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime        @default(now())
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model AuthChallenge {
  id             String               @id @default(cuid())
  userId         String
  purpose        AuthChallengePurpose
  secretHash     String
  expiresAt      DateTime
  consumedAt     DateTime?
  failedAttempts Int                  @default(0)
  createdAt      DateTime             @default(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([purpose, secretHash])
}

model CompanySetting {
  id        String   @id @default(cuid())
  companyId String   @unique
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Godown {
  id             String          @id @default(cuid())
  companyId      String
  factoryId      String
  name           String
  code           String
  active         Boolean         @default(true)
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory        Factory         @relation(fields: [companyId, factoryId], references: [companyId, id], onDelete: Restrict)
  stacks         Stack[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@unique([factoryId, code])
  @@unique([companyId, factoryId, id])
  @@index([companyId, factoryId])
}

model Stack {
  companyId            String
  factoryId            String
  id                   String             @id @default(cuid())
  godownId             String
  code                 String
  capacityKg           Decimal            @db.Decimal(14, 3)
  materialItemId       String?
  varietyName          String?
  cropYear             Int?
  batchNumber          String?
  lotNumber            String?
  receivedAt           DateTime?
  godown               Godown             @relation(fields: [companyId, factoryId, godownId], references: [companyId, factoryId, id], onDelete: Restrict)
  materialItem         Item?              @relation("StackMaterial", fields: [companyId, materialItemId], references: [companyId, id], onDelete: Restrict)
  stockMovements       StockMovement[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  sourceTransfers      StockTransfer[]    @relation("TransferSourceStack")
  destinationTransfers StockTransfer[]    @relation("TransferDestinationStack")
  stockAdjustments     StockAdjustment[]
  stockCounts          StockCount[]
  productionInputs     ProductionBatch[]  @relation("ProductionInputStack")
  productionOutputs    ProductionOutput[]
  dryingInputBatches   DryingBatch[]      @relation("DryingInputStack")
  dryingOutputBatches  DryingBatch[]      @relation("DryingOutputStack")
  parboilingInputs     ParboilingBatch[]  @relation("ParboilingInputStack")
  parboilingOutputs    ParboilingBatch[]  @relation("ParboilingOutputStack")
  repackingSourceBatches RepackingBatch[] @relation("RepackingSourceStack")
  repackingDestinationBatches RepackingBatch[] @relation("RepackingDestinationStack")
  salesOrderLines SalesOrderLine[]
  dispatchLines   DispatchLine[]

  @@unique([godownId, code])
  @@unique([companyId, factoryId, id])
  @@unique([companyId, factoryId, godownId, id])
  @@index([companyId, factoryId])
  @@index([companyId, factoryId, receivedAt])
  @@index([materialItemId])
}

model ProductionLine {
  id        String            @id @default(cuid())
  companyId String
  factoryId String
  name      String
  code      String
  active    Boolean           @default(true)
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory   Factory           @relation(fields: [companyId, factoryId], references: [companyId, id], onDelete: Restrict)
  batches   ProductionBatch[]

  @@unique([factoryId, code])
  @@unique([companyId, factoryId, id])
  @@index([companyId, factoryId])
}

model Partner {
  id               String                @id @default(cuid())
  companyId        String
  type             PartnerType
  name             String
  code             String
  phone            String?
  businessName     String?
  email            String?
  address          String?
  nid              String?
  tin              String?
  bin              String?
  bankName         String?
  bankAccount      String?
  paymentMethod    String?
  creditLimit      Decimal?              @db.Decimal(18, 2)
  paymentTermsDays Int?
  commissionType   BrokerCommissionType?
  commissionRate   Decimal?              @db.Decimal(18, 4)
  openingBalance   Decimal               @default(0) @db.Decimal(18, 2)
  active           Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  company          Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  packagingSpecs   PackagingSpec[]       @relation("PackagingSupplier")
  gateEntries      GateEntry[]
  purchaseOrders   PurchaseOrder[]
  brokerPurchaseOrders PurchaseOrder[]   @relation("PurchaseBroker")
  moisturePolicies     MoisturePolicy[]  @relation("MoisturePolicySupplier")
  purchaseInvoices     PurchaseInvoice[]
  salesQuotations      SalesQuotation[]      @relation("SalesQuotationCustomer")
  salesOrders          SalesOrder[]          @relation("SalesOrderCustomer")
  dispatches           Dispatch[]            @relation("DispatchCustomer")

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, type, name])
}

model Item {
  id                    String             @id @default(cuid())
  companyId             String
  kind                  ItemKind
  name                  String
  code                  String
  variety               String?
  cropYear              Int?
  grade                 String?
  localName             String?
  brand                 String?
  riceType              String?
  byProductType         String?
  defaultPackagingLabel String?
  standardMoisture      Decimal?           @db.Decimal(5, 2)
  standardRecovery      Decimal?           @db.Decimal(5, 2)
  headRicePercentage    Decimal?           @db.Decimal(5, 2)
  brokenPercentage      Decimal?           @db.Decimal(5, 2)
  purchasePrice         Decimal?           @db.Decimal(18, 4)
  salesPrice            Decimal?           @db.Decimal(18, 4)
  description           String?
  baseUnit              UnitOfMeasure      @default(KG)
  active                Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  company               Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  stockMovements        StockMovement[]
  gateEntries           GateEntry[]
  purchaseOrders        PurchaseOrder[]
  stockTransfers        StockTransfer[]
  stockAdjustments      StockAdjustment[]
  stockCounts           StockCount[]
  productionInputs      ProductionBatch[]  @relation("ProductionInputItem")
  productionOutputs     ProductionOutput[]
  dryingBatches         DryingBatch[]
  parboilingInputs      ParboilingBatch[]  @relation("ParboilingInputItem")
  parboilingOutputs     ParboilingBatch[]  @relation("ParboilingOutputItem")
  repackingSourceBatches RepackingBatch[] @relation("RepackingSourceItem")
  repackingOutputBatches RepackingBatch[] @relation("RepackingOutputItem")
  repackingPackagingBatches RepackingBatch[] @relation("RepackingPackagingItem")
  salesQuotationLines   SalesQuotationLine[]
  salesOrderLines       SalesOrderLine[]   @relation("SalesOrderItem")
  salesOrderPackagingLines SalesOrderLine[] @relation("SalesOrderPackagingItem")
  dispatchLines         DispatchLine[]     @relation("DispatchLineItem")
  dispatchPackagingLines DispatchLine[]    @relation("DispatchPackagingItem")
  packagingSpec         PackagingSpec?
  designatedStacks      Stack[]            @relation("StackMaterial")
  moisturePolicies      MoisturePolicy[]   @relation("MoisturePolicyVariety")

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@index([companyId, kind, name])
}

model PackagingSpec {
  id                String   @id @default(cuid())
  companyId         String
  itemId            String   @unique
  supplierPartnerId String?
  bagType           String?
  sizeKg            Decimal  @db.Decimal(14, 3)
  material          String
  unitCost          Decimal  @default(0) @db.Decimal(18, 4)
  item              Item     @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)
  supplier          Partner? @relation("PackagingSupplier", fields: [companyId, supplierPartnerId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, itemId])
  @@index([supplierPartnerId])
}

model UnitConversion {
  id            String        @id @default(cuid())
  companyId     String
  fromUnit      UnitOfMeasure
  toUnit        UnitOfMeasure
  factor        Decimal       @db.Decimal(18, 8)
  effectiveFrom DateTime      @default(now())
  createdAt     DateTime      @default(now())
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, fromUnit, toUnit, effectiveFrom])
  @@index([companyId, fromUnit, toUnit, effectiveFrom])
}

model MoisturePolicy {
  id                  String                   @id @default(cuid())
  companyId           String
  name                String
  factoryId           String?
  paddyItemId         String?
  supplierPartnerId   String?
  active              Boolean                  @default(true)
  priority            Int                      @default(0)
  allowedMoisturePct  Decimal                  @db.Decimal(7, 3)
  tolerancePct        Decimal                  @default(0) @db.Decimal(7, 3)
  formula             MoistureDeductionFormula
  rateDeductionPct    Decimal                  @default(0) @db.Decimal(7, 4)
  slabs               Json                     @default("[]")
  createdById         String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory             Factory?                 @relation(fields: [companyId, factoryId], references: [companyId, id], onDelete: Restrict)
  paddyItem           Item?                    @relation("MoisturePolicyVariety", fields: [companyId, paddyItemId], references: [companyId, id], onDelete: Restrict)
  supplier            Partner?                @relation("MoisturePolicySupplier", fields: [companyId, supplierPartnerId], references: [companyId, id], onDelete: Restrict)
  createdBy           User                    @relation("MoisturePolicyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  purchaseOrders      PurchaseOrder[]

  @@unique([companyId, id])
  @@index([companyId, active, priority])
  @@index([companyId, factoryId, active, priority])
  @@index([companyId, paddyItemId, supplierPartnerId])
}

model StockMovement {
  id           String            @id @default(cuid())
  companyId    String
  factoryId    String
  itemId       String
  stackId      String?
  type         StockMovementType
  quantity     Decimal           @db.Decimal(18, 3)
  unit         UnitOfMeasure     @default(KG)
  unitCost     Decimal?          @db.Decimal(18, 4)
  sourceType   String
  sourceId     String
  reversalOfId String?
  occurredAt   DateTime          @default(now())
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory      Factory           @relation(fields: [companyId, factoryId], references: [companyId, id], onDelete: Restrict)
  item         Item              @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  stack        Stack?            @relation(fields: [companyId, factoryId, stackId], references: [companyId, factoryId, id], onDelete: Restrict)
  reversalOf   StockMovement?    @relation("MovementReversal", fields: [companyId, reversalOfId], references: [companyId, id], onDelete: Restrict)
  reversals    StockMovement[]   @relation("MovementReversal")

  @@unique([sourceType, sourceId, type, stackId])
  @@unique([companyId, id])
  @@index([companyId, factoryId, itemId, occurredAt])
  @@index([sourceType, sourceId])
}

model StockTransfer {
  id                 String   @id @default(cuid())
  companyId          String
  factoryId          String
  transferNumber     String
  itemId             String
  sourceStackId      String
  destinationStackId String
  quantity           Decimal  @db.Decimal(18, 3)
  reason             String?
  createdById        String
  createdAt          DateTime @default(now())
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory            Factory  @relation(fields: [companyId, factoryId], references: [companyId, id], onDelete: Restrict)
  item               Item     @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  sourceStack        Stack    @relation("TransferSourceStack", fields: [companyId, factoryId, sourceStackId], references: [companyId, factoryId, id], onDelete: Restrict)
  destinationStack   Stack    @relation("TransferDestinationStack", fields: [companyId, factoryId, destinationStackId], references: [companyId, factoryId, id], onDelete: Restrict)
  createdBy          User     @relation("StockTransferCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, transferNumber])
  @@index([companyId, factoryId, itemId, createdAt])
}

model StockAdjustment {
  id               String   @id @default(cuid())
  companyId        String
  factoryId        String
  adjustmentNumber String
  itemId           String
  stackId          String
  quantity         Decimal  @db.Decimal(18, 3)
  reason           String
  createdById      String
  createdAt        DateTime @default(now())
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory          Factory  @relation(fields: [companyId, factoryId], references: [companyId, id], onDelete: Restrict)
  item             Item     @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  stack            Stack    @relation(fields: [companyId, factoryId, stackId], references: [companyId, factoryId, id], onDelete: Restrict)
  createdBy        User     @relation("StockAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, adjustmentNumber])
  @@index([companyId, factoryId, itemId, createdAt])
}

model StockCount {
  id                 String         @id @default(cuid())
  companyId          String
  factoryId          String
  countNumber        String
  itemId             String
  stackId            String
  bookQuantity       Decimal        @db.Decimal(18, 3)
  countedQuantity    Decimal        @db.Decimal(18, 3)
  adjustmentQuantity Decimal        @db.Decimal(18, 3)
  unit               UnitOfMeasure  @default(KG)
