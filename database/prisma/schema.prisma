  EMAIL
  SMS
  WHATSAPP
}

enum NotificationType {
  DUE
  PAYMENT
  LOW_STOCK
  APPROVAL
  PRODUCTION
  QUALITY
  VEHICLE
  DOCUMENT_EXPIRY
  MAINTENANCE
}

