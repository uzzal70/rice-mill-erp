  goodsReceipt           GoodsReceipt   @relation(fields: [companyId, factoryId, goodsReceiptId], references: [companyId, factoryId, id], onDelete: Restrict)
  purchaseOrder          PurchaseOrder  @relation(fields: [companyId, factoryId, purchaseOrderId], references: [companyId, factoryId, id], onDelete: Restrict)
  supplier               Partner        @relation(fields: [companyId, supplierId], references: [companyId, id], onDelete: Restrict)
  createdBy              User           @relation("PurchaseInvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy             User?          @relation("PurchaseInvoiceApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  postedBy               User?          @relation("PurchaseInvoicePoster", fields: [postedById], references: [id], onDelete: Restrict)
  landedCosts            LandedCost[]

  @@unique([companyId, invoiceNumber])
  @@unique([companyId, goodsReceiptId])
  @@unique([companyId, factoryId, goodsReceiptId])
  @@unique([companyId, factoryId, id])
  @@index([companyId, factoryId, status, invoiceDate])
  @@index([companyId, supplierId, status])
}

model Journal {
  id           String        @id @default(cuid())
  companyId    String
  number       String
  sourceType   String
  sourceId     String
  status       JournalStatus @default(DRAFT)
  currency     String        @default("BDT")
  postedAt     DateTime?
  reversalOfId String?
  createdAt    DateTime      @default(now())
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lines        JournalLine[]
  reversalOf   Journal?      @relation("JournalReversal", fields: [companyId, reversalOfId], references: [companyId, id], onDelete: Restrict)
  reversals    Journal[]     @relation("JournalReversal")

  @@unique([companyId, number])
  @@unique([companyId, id])
  @@unique([sourceType, sourceId])
  @@index([companyId, postedAt])
}

model JournalLine {
  id          String  @id @default(cuid())
  journalId   String
  accountCode String
  description String?
  debit       Decimal @default(0) @db.Decimal(18, 2)
  credit      Decimal @default(0) @db.Decimal(18, 2)
  journal     Journal @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@index([accountCode])
}

model AuditEvent {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  requestId  String?
  before     Json?
  after      Json?
  occurredAt DateTime @default(now())
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, occurredAt])
  @@index([resource, resourceId])
}

model Vehicle {
  id                 String      @id @default(cuid())
  companyId          String
  vehicleNumber      String
  registrationNumber String?
  vehicleType        String
  ownerName          String?
  driverName         String?
  driverMobile       String?
  fitnessExpiry      DateTime?
  insuranceExpiry    DateTime?
  taxTokenExpiry     DateTime?
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  gateEntries        GateEntry[]

  @@unique([companyId, id])
  @@unique([companyId, vehicleNumber])
  @@index([companyId, active])
}

model GateEntry {
  id                String             @id @default(cuid())
  companyId         String
  factoryId         String
  gateNumber        String
  direction         GateDirection
  purpose           GatePurpose
  status            GateStatus         @default(ENTRY)
  vehicleId         String?
  vehicleNumber     String
  driverName        String?
  driverMobile      String?
  partnerId         String?
  itemId            String?
  challanNumber     String?
  referenceNumber   String?
  remarks           String?
  enteredAt         DateTime           @default(now())
  completedAt       DateTime?
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory           Factory            @relation(fields: [companyId, factoryId], references: [companyId, id], onDelete: Restrict)
  vehicle           Vehicle?           @relation(fields: [companyId, vehicleId], references: [companyId, id], onDelete: Restrict)
  partner           Partner?           @relation(fields: [companyId, partnerId], references: [companyId, id], onDelete: Restrict)
  item              Item?              @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  createdBy         User               @relation("GateEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  weighbridgeTicket WeighbridgeTicket?
  qualitySamples    QualitySample[]
  attachments       GateAttachment[]
  purchaseOrder     PurchaseOrder?

  @@unique([companyId, factoryId, id])
  @@unique([companyId, gateNumber])
  @@index([companyId, factoryId, status, enteredAt])
  @@index([companyId, vehicleId, enteredAt])
}

model GateAttachment {
  id           String   @id @default(cuid())
  companyId    String
  factoryId    String
  gateEntryId  String
  fileName     String
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory      Factory   @relation(fields: [companyId, factoryId], references: [companyId, id], onDelete: Restrict)
  gateEntry    GateEntry @relation(fields: [companyId, factoryId, gateEntryId], references: [companyId, factoryId, id], onDelete: Restrict)
  uploadedBy   User      @relation("GateAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([companyId, factoryId, gateEntryId, createdAt])
}

model WeighbridgeTicket {
  id             String    @id @default(cuid())
  companyId      String
  factoryId      String
  gateEntryId    String    @unique
  ticketNumber   String
  grossWeight    Decimal   @db.Decimal(18, 3)
  tareWeight     Decimal   @db.Decimal(18, 3)
  netWeight      Decimal   @db.Decimal(18, 3)
  firstWeightAt  DateTime
  secondWeightAt DateTime
  isManual       Boolean   @default(true)
  remarks        String?
  operatorId     String
  createdAt      DateTime  @default(now())
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory        Factory   @relation(fields: [companyId, factoryId], references: [companyId, id], onDelete: Restrict)
  gateEntry      GateEntry @relation(fields: [companyId, factoryId, gateEntryId], references: [companyId, factoryId, id], onDelete: Restrict)
  operator       User      @relation("WeighbridgeOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  @@unique([companyId, ticketNumber])
  @@unique([companyId, factoryId, gateEntryId])
  @@index([companyId, factoryId, firstWeightAt])
}

model QualitySample {
  id           String              @id @default(cuid())
  companyId    String
  factoryId    String
  gateEntryId  String
  sampleNumber String
  sampleType   QualitySampleType
  status       QualitySampleStatus @default(SAMPLE)
  measurements Json                @default("{}")
  decision     QualityDecision?
  comments     String?
  sampledById  String
  testedById   String?
  approvedById String?
  testedAt     DateTime?
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory      Factory             @relation(fields: [companyId, factoryId], references: [companyId, id], onDelete: Restrict)
  gateEntry    GateEntry           @relation(fields: [companyId, factoryId, gateEntryId], references: [companyId, factoryId, id], onDelete: Restrict)
  sampledBy    User                @relation("QualitySampler", fields: [sampledById], references: [id], onDelete: Restrict)
  testedBy     User?               @relation("QualityTester", fields: [testedById], references: [id], onDelete: Restrict)
  approvedBy   User?               @relation("QualityApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, sampleNumber])
  @@unique([companyId, factoryId, id])
  @@index([companyId, factoryId, gateEntryId, createdAt])
}

model LandedCostComponentConfig {
  id          String                  @id @default(cuid())
  companyId   String
  factoryId   String?
  name        String
  code        String
  type        LandedCostComponentType
  isActive    Boolean                 @default(true)
  isRequired  Boolean                 @default(false)
  sortOrder   Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory     Factory?                @relation(fields: [companyId, factoryId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([companyId, factoryId, isActive])
  @@map("landed_cost_component_configs")
}

model LandedCost {
  id                    String         @id @default(cuid())
  companyId             String
  factoryId             String
  goodsReceiptId        String         @unique
  purchaseOrderId       String
  purchaseInvoiceId     String?
  quantityKg            Decimal        @db.Decimal(18, 3)
  purchaseCost          Decimal        @db.Decimal(18, 2)
  transportCost         Decimal        @default(0) @db.Decimal(18, 2)
  loadingCost           Decimal        @default(0) @db.Decimal(18, 2)
  unloadingCost         Decimal        @default(0) @db.Decimal(18, 2)
  commissionCost        Decimal        @default(0) @db.Decimal(18, 2)
  dryingCost            Decimal        @default(0) @db.Decimal(18, 2)
  otherDirectCost       Decimal        @default(0) @db.Decimal(18, 2)
  totalAdditionalCost   Decimal        @db.Decimal(18, 2)
  landedCostTotal       Decimal        @db.Decimal(18, 2)
  landedCostPerKg       Decimal        @db.Decimal(18, 4)
  landedCostPerMon      Decimal        @db.Decimal(18, 4)
  landedCostPerTon      Decimal        @db.Decimal(18, 4)
  components            Json?
  calculatedById        String
  calculatedAt          DateTime       @default(now())
  status                DocumentStatus @default(DRAFT)
  approvedById          String?
  approvedAt            DateTime?
  postedById            String?
  postedAt              DateTime?
  remarks               String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  company               Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory               Factory        @relation(fields: [companyId, factoryId], references: [companyId, id], onDelete: Restrict)
  goodsReceipt          GoodsReceipt   @relation(fields: [companyId, factoryId, goodsReceiptId], references: [companyId, factoryId, id], onDelete: Restrict)
  purchaseOrder         PurchaseOrder  @relation(fields: [companyId, factoryId, purchaseOrderId], references: [companyId, factoryId, id], onDelete: Restrict)
  purchaseInvoice       PurchaseInvoice? @relation(fields: [companyId, factoryId, purchaseInvoiceId], references: [companyId, factoryId, id], onDelete: Restrict)
  calculatedBy          User           @relation("LandedCostCalculatedBy", fields: [calculatedById], references: [id], onDelete: Restrict)
  approvedBy            User?          @relation("LandedCostApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  postedBy              User?          @relation("LandedCostPoster", fields: [postedById], references: [id], onDelete: Restrict)

  @@index([companyId, factoryId])
  @@index([companyId, purchaseOrderId])
  @@unique([companyId, factoryId, goodsReceiptId])
  @@map("landed_costs")
}
