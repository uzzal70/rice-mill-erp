enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertCategory {
  INVENTORY
  QUALITY
  FINANCE
  COMPLIANCE
  MAINTENANCE
  OPERATIONS
}

enum AlertType {
  LOW_STOCK
  HIGH_MOISTURE
  LOW_RECOVERY
  CUSTOMER_OVERDUE
  SUPPLIER_PAYMENT_DUE
  DOCUMENT_EXPIRING
  MACHINE_MAINTENANCE_DUE
  UNUSUAL_WEIGHT
  UNUSUAL_PRODUCTION_LOSS
  NEGATIVE_MARGIN
  SLOW_MOVING_STOCK
}

model SmartAlert {
  id               String        @id @default(cuid())
  companyId        String
  factoryId        String?
  type             AlertType
  category         AlertCategory
  severity         AlertSeverity @default(WARNING)
  title            String
  message          String
  referenceType    String?
  referenceId      String?
  metricValue      Decimal?      @db.Decimal(18, 4)
  thresholdValue   Decimal?      @db.Decimal(18, 4)
  isDismissed      Boolean       @default(false)
  dismissedAt      DateTime?
  dismissedById    String?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company          Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  factory          Factory?      @relation(fields: [factoryId], references: [id], onDelete: SetNull)

  @@index([companyId, isDismissed, severity])
  @@index([companyId, type, referenceId])
}

model AlertRule {
